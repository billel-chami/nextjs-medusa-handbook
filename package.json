{
  "name": "ecom-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:storefront": "pnpm --filter @ecom/storefront dev",
    "dev:backend": "pnpm --filter @ecom/backend dev",
    "build:storefront": "pnpm --filter @ecom/storefront build",
    "build:backend": "pnpm --filter @ecom/backend build",
    "typecheck": "pnpm --recursive run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.10.0"
}

